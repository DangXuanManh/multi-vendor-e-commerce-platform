  <!-- 5. SƠ ĐỒ TUẦN TỰ (NHIỀU SƠ ĐỒ TUẦN TỰ TRÊN CÙNG TAB) - NỀN ĐEN CHỮ TRẮNG -->
  <diagram id="sequence-diagram" name="5. Sơ đồ tuần tự (Sequence Diagrams)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq_cust" value="Khách Hàng" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="120" height="600" as="geometry" />
        </mxCell>
        <mxCell id="seq_ctrl" value="CheckoutController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="140" height="600" as="geometry" />
        </mxCell>
        <mxCell id="seq_srv" value="OrderService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="130" height="600" as="geometry" />
        </mxCell>
        <mxCell id="seq_repo" value="OrderRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="130" height="600" as="geometry" />
        </mxCell>
        <mxCell id="seq_db" value="MySQL Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="40" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1. Gửi thông tin đặt hàng POST /checkout/process" edge="1" parent="1" source="seq_cust" target="seq_ctrl" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="120" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. Call placeOrder(cart, customer, address)" edge="1" parent="1" source="seq_ctrl" target="seq_srv" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="180" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. Tạo Order &amp; Phân nhóm OrderItem theo Shop" edge="1" parent="1" source="seq_srv" target="seq_srv" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="240" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. save(Order)" edge="1" parent="1" source="seq_srv" target="seq_repo" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="300" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. INSERT INTO orders &amp; order_items" edge="1" parent="1" source="seq_repo" target="seq_db" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="360" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. Trả về kết quả lưu CSDL thành công" edge="1" parent="1" source="seq_db" target="seq_repo" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="420" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. Trả về đối tượng Saved Order" edge="1" parent="1" source="seq_repo" target="seq_srv" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="480" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. Clear Cart Session &amp; Redirect" edge="1" parent="1" source="seq_srv" target="seq_ctrl" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="520" as="offset" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9. Hiển thị Trang Hóa Đơn (Invoice Detail)" edge="1" parent="1" source="seq_ctrl" target="seq_cust" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint y="560" as="offset" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- 6. SƠ ĐỒ LỚP (CLASS DIAGRAM) - NỀN ĐEN CHỮ TRẮNG -->
  <diagram id="class-diagram" name="6. Sơ đồ lớp (Class Diagram)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cls_user" value="User&#xa;------------------&#xa;- id: Long&#xa;- username: String&#xa;- password: String&#xa;- fullName: String&#xa;- email: String&#xa;- role: String&#xa;------------------&#xa;+ getAuthorities()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="180" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cls_shop" value="Shop&#xa;------------------&#xa;- id: Long&#xa;- name: String&#xa;- description: String&#xa;- status: String&#xa;- vendor: User&#xa;------------------&#xa;+ getProducts()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="180" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cls_prod" value="Product&#xa;------------------&#xa;- id: Long&#xa;- name: String&#xa;- price: BigDecimal&#xa;- stockQuantity: Integer&#xa;- category: Category&#xa;- shop: Shop&#xa;------------------&#xa;+ isAvailable()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cls_order" value="Order&#xa;------------------&#xa;- id: Long&#xa;- recipientName: String&#xa;- totalAmount: BigDecimal&#xa;- customer: User&#xa;- items: List&lt;OrderItem&gt;&#xa;------------------&#xa;+ calculateTotal()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="190" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cls_item" value="OrderItem&#xa;------------------&#xa;- id: Long&#xa;- quantity: Integer&#xa;- price: BigDecimal&#xa;- product: Product&#xa;- shop: Shop&#xa;------------------&#xa;+ getSubtotal()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cls_srv" value="OrderServiceImpl&#xa;------------------&#xa;- orderRepo: OrderRepository&#xa;- productRepo: ProductRepository&#xa;------------------&#xa;+ placeOrder(cart, user)" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ca1" value="1 --- 1" edge="1" parent="1" source="cls_user" target="cls_shop" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca2" value="1 --- *" edge="1" parent="1" source="cls_shop" target="cls_prod" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca3" value="1 --- *" edge="1" parent="1" source="cls_user" target="cls_order" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca4" value="1 --- *" edge="1" parent="1" source="cls_order" target="cls_item" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca5" value="* --- 1" edge="1" parent="1" source="cls_item" target="cls_prod" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- 7. SƠ ĐỒ THỰC THỂ LIÊN KẾT ERD - NỀN ĐEN CHỮ TRẮNG -->
  <diagram id="erd-diagram" name="7. Sơ đồ Thực thể Liên kết (ERD)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="e_users" value="USERS&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;username: VARCHAR(50)&#xa;password: VARCHAR(255)&#xa;full_name: VARCHAR(100)&#xa;email: VARCHAR(100)&#xa;role: VARCHAR(20)" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontStyle=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e_shops" value="SHOPS&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;name: VARCHAR(100)&#xa;description: TEXT&#xa;address: VARCHAR(255)&#xa;status: VARCHAR(20)&#xa;* vendor_id (FK): BIGINT" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontStyle=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e_cat" value="CATEGORIES&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;name: VARCHAR(100)&#xa;description: TEXT" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontStyle=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="e_prod" value="PRODUCTS&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;name: VARCHAR(150)&#xa;price: DECIMAL(12,2)&#xa;stock_quantity: INT&#xa;* category_id (FK): BIGINT&#xa;* shop_id (FK): BIGINT" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontStyle=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="570" y="350" width="230" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e_orders" value="ORDERS&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;* customer_id (FK): BIGINT&#xa;recipient_name: VARCHAR(100)&#xa;shipping_address: VARCHAR(255)&#xa;total_amount: DECIMAL(12,2)&#xa;status: VARCHAR(20)" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontStyle=1;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="230" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e_items" value="ORDER_ITEMS&#xa;----------------------&#xa;* id (PK): BIGINT&#xa;* order_id (FK): BIGINT&#xa;* product_id (FK): BIGINT&#xa;* shop_id (FK): BIGINT&#xa;quantity: INT&#xa;price: DECIMAL(12,2)" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="580" width="220" height="170" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="1 : 1" edge="1" parent="1" source="e_users" target="e_shops" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" value="1 : N" edge="1" parent="1" source="e_shops" target="e_prod" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" value="1 : N" edge="1" parent="1" source="e_cat" target="e_prod" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r4" value="1 : N" edge="1" parent="1" source="e_users" target="e_orders" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r5" value="1 : N" edge="1" parent="1" source="e_orders" target="e_items" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r6" value="1 : N" edge="1" parent="1" source="e_prod" target="e_items" style="strokeColor=#ffffff;fontColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

